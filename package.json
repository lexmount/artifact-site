{
  "name": "artifact-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/sync-pdfjs.mjs",
    "dev": "next dev --port 4300",
    "prebuild": "node scripts/sync-pdfjs.mjs",
    "build": "next build --webpack",
    "start": "next start --port 4300",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:commit-msg": "node scripts/check-commit-msg.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.2",
    "jose": "^6.2.12",
    "lucide-react": "1.44.0",
    "marked": "^18.0.12",
    "next": "16.3.4",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "puppeteer-core": "^25.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "license": "(Apache-2.0 OR MIT)",
  "repository": {
    "type": "git",
    "url": "https://github.com/lexmount/artifact-site.git"
  },
  "description": "Self-hosted platform for publishing and sharing front-end artifacts and documents: drop an HTML file, a build directory, a zip or a PDF/Office file and get a sandboxed, versioned, shareable link",
  "homepage": "https://github.com/lexmount/artifact-site#readme",
  "bugs": {
    "url": "https://github.com/lexmount/artifact-site/issues"
  },
  "keywords": [
    "artifacts",
    "static-hosting",
    "self-hosted",
    "sandbox",
    "ai-agents",
    "mcp",
    "nextjs"
  ]
}
