# ── artifact-site runtime configuration ──────────────────────────────────────
# Copy with `cp .env.example .env` for a localhost-only trial, then run `make build up`.
# For a team deployment, set the public URL, authentication and visibility before exposing it.
# Only fill in what you have:
# whatever is left blank is filled in by `make up` (no external Postgres → a bundled one;
# no S3 → files are written to local disk). Run `make doctor` once you are done.
#
# Rules (compose's .env syntax): one KEY=VALUE per line, no spaces around =, no export;
# a literal $ inside a value must be written $$; numeric variables accept plain digits only
# (50MB is silently ignored); an inline comment (" # …" after VALUE) is stripped as a comment,
# so quote the whole value if it contains #.
#
# Upgrading from the old version (SQLite single-replica compose): this version does not migrate
# the data in SQLite, old sites will not appear in the new database; make doctor warns when it
# detects the old container/volume.

# ════════════════════════════════════════════════════════════════════════
# 1. Required
# ════════════════════════════════════════════════════════════════════════

# The canonical public address of this site, no trailing slash. Once set, never change it: the OIDC
# callback, the CSRF check on write routes and the API address /for-agents.md hands to agents are
# all derived from it. Must be set when running behind a reverse proxy.
ARTIFACT_PUBLIC_URL=http://127.0.0.1:4300

# Who can create sites: open (any visitor) / login (must be logged in; needs the OIDC settings in
# section 4) / token (must carry a Bearer).
# When empty: token if PUBLISH_API_TOKEN is set, otherwise open. Do not leave it at open on the public internet.
ARTIFACT_CREATE_POLICY=open

# ════════════════════════════════════════════════════════════════════════
# 2. Bundled Postgres (used by `make up`; active when ARTIFACT_DATABASE_URL is empty)
# ════════════════════════════════════════════════════════════════════════

# Leave empty: make doctor / make up generate one and write it back here when it is blank. If you set
# it yourself, use only letters, digits and _ . -.
# Once set, never change it: the password in the database is baked into the data directory on first
# start, and changing it here afterwards only stops the app from connecting.
# If you really must: make psql → ALTER ROLE artifact_hub PASSWORD 'new password'; then change it here and make restart.
POSTGRES_PASSWORD=
# Where the database files live (host path, default ./pgdata under the repository). Put it on the data disk and include it in backups.
POSTGRES_DATA_PATH=./pgdata
# The port it is reachable on from the host (bound to 127.0.0.1 only, for make psql / make dev).
POSTGRES_PORT=55432
# POSTGRES_IMAGE=postgres:18-alpine

# ════════════════════════════════════════════════════════════════════════
# 3. External dependencies (set = use the external one; empty = previous section / local disk)
# ════════════════════════════════════════════════════════════════════════

# External Postgres. The role must be allowed to create tables: tables and indexes are created by the
# app at startup with CREATE … IF NOT EXISTS; there is no separate migration command. For TLS put it
# in the URL (?sslmode=require); the app reads no other PG* variables.
ARTIFACT_DATABASE_URL=

# Object storage (any S3-compatible service: AWS S3 / MinIO / Tencent COS / Alibaba OSS…). Setting BUCKET switches to object storage automatically; all four are required.
# Besides object read/write/delete the credentials need ListBucket (list directories / delete by prefix), HeadObject and CopyObject (fork/edit).
# Must be a brand-new empty bucket. Changing any ARTIFACT_S3_* requires make restart (credentials are baked in at startup).
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
# REGION as the service expects (AWS e.g. us-east-1; COS e.g. ap-nanjing; MinIO anything, but it must match the server); empty = us-east-1.
# FORCE_PATH_STYLE: true for path-addressed services such as MinIO; false for virtual-host-addressed ones such as AWS / COS.
ARTIFACT_S3_REGION=
ARTIFACT_S3_FORCE_PATH_STYLE=false
# In-process preview read cache limit (bytes), default 128MB; one per replica when running several.
# ARTIFACT_S3_CACHE_BYTES=134217728

# Only set this to force a choice (normally empty, inferred from the above): local | s3
ARTIFACT_STORAGE_DRIVER=
# postgres is the only metadata store; leave empty. sqlite is for the test runner only and refuses to start in production.
ARTIFACT_DB_DRIVER=

# ════════════════════════════════════════════════════════════════════════
# 4. Login (OIDC; required when ARTIFACT_CREATE_POLICY=login)
# ════════════════════════════════════════════════════════════════════════

# The other endpoints are discovered from the issuer. The callback <ARTIFACT_PUBLIC_URL>/api/auth/callback
# must be registered verbatim on the IdP's allow list — if it is not, the IdP returns 400 and this app logs nothing.
# Google: ARTIFACT_OIDC_ISSUER=https://accounts.google.com with an OAuth client from the Google Cloud console
# (DEPLOY.md section 1.3). Logto / Keycloak / Authentik / Okta / Auth0: the issuer the platform advertises.
ARTIFACT_OIDC_ISSUER=
ARTIFACT_OIDC_CLIENT_ID=
ARTIFACT_OIDC_CLIENT_SECRET=
# Only change this when the IdP side already has the old path registered: /api/auth/callback (default) or /v1/access/auth/oauth/callback
# ARTIFACT_OIDC_REDIRECT_PATH=
# Administrators, by sign-in e-mail (comma-separated, verified by the IdP). They get the administration console
# (/admin: users, sites, take-downs, maintenance). Empty = no console; PUBLISH_API_TOKEN as a Bearer still works for scripts.
# ARTIFACT_ADMIN_EMAILS=
# Without OIDC, anonymous editing still works via edit tokens. Once OIDC is configured,
# on enables account-based authorization automatically.
# on = owners/collaborators are authorised by login state. A fresh environment can turn it on from day one; keep it off during a rolling upgrade (old and new images coexisting).
ARTIFACT_ENFORCE_OWNERSHIP=on

# OAuth for MCP clients (ChatGPT, Claude, …): on whenever OIDC sign-in is configured; nothing to set for the default.
# Tokens are bound to ARTIFACT_PUBLIC_URL — it must be the exact address clients connect to. The three knobs below can
# also be changed from the administration console (/admin/settings) without a restart; a console value overrides the variable.
# Restrict which hosts may connect (client metadata documents and redirect addresses): comma-separated hostnames,
# subdomains included; with a list set, only https redirects to listed hosts are accepted (no loopback or app-scheme
# clients such as a CLI or Cursor). Empty = any public https host, loopback listeners and application schemes.
# ARTIFACT_OAUTH_CLIENT_HOSTS=chatgpt.com,claude.ai
# off = no dynamic client registration (RFC 7591); clients with a metadata document (ChatGPT) still connect.
# ARTIFACT_OAUTH_DCR=on
# Application schemes admitted as return addresses on top of the reverse-domain shape (com.example.app:) and
# cursor / vscode / vscode-insiders — one per editor you want to admit, comma-separated.
# ARTIFACT_OAUTH_APP_SCHEMES=windsurf,zed

# ════════════════════════════════════════════════════════════════════════
# 5. Optional
# ════════════════════════════════════════════════════════════════════════

# Default visibility of new sites: public | unlisted | private. Empty = private (the cautious posture: the link is
# 404 to outsiders until shared, and an agent has to create a share link after publishing before anyone can see it).
# New sites are private by default, including in the local trial. Use Sharing to grant access.
ARTIFACT_DEFAULT_VISIBILITY=private

# Administrator token. When set: POST /api/sites requires the Bearer (so drag-and-drop upload in the browser returns 401), and it can edit/delete any site.
# Usually left empty on intranet deployments. Generate with: openssl rand -base64 32
PUBLISH_API_TOKEN=

# Only when hosted artifacts need to call external APIs: comma-separated full origins (https://api.example.com). Do not put 'self' here.
CSP_CONNECT_SRC=

# Office document preview (docx/pptx → pdf). on = `make up` brings its own Gotenberg (about 1GB of memory);
# if you already have one, set GOTENBERG_URL; with neither, office documents show as a download card and pdf preview is unaffected.
ARTIFACT_WITH_GOTENBERG=off
GOTENBERG_URL=
# ARTIFACT_CONVERT_TIMEOUT_MS=60000
# ARTIFACT_CONVERT_CONCURRENCY=2

# Bundled reverse proxy + automatic certificates (Caddy, takes 80/443). Keep it off when the host already has
# nginx/caddy and point that at 127.0.0.1:4300 instead (snippet in SELFHOST.md).
ARTIFACT_WITH_CADDY=off
ARTIFACT_DOMAIN=

# Deleted sites keep their files this many days so an administrator can restore them; then they are purged. 0 = purge at the next maintenance run.
# ARTIFACT_DELETED_RETENTION_DAYS=30

# Per-owner caps (0 or unset = unlimited). Every version counts towards the bytes. Recommended on any deployment where strangers publish:
# ARTIFACT_QUOTA_SITES_PER_USER=200
# ARTIFACT_QUOTA_BYTES_PER_USER=5368709120
# ARTIFACT_QUOTA_SITES_PER_ANON=20
# ARTIFACT_QUOTA_BYTES_PER_ANON=536870912
# What the browser that created a site anonymously may do before anyone signs in: full (default: it owns the site) or
# read-only (it can only open it; editing, sharing, deleting ask for a sign-in, after which the site is the account's).
# ARTIFACT_ANONYMOUS_SITES=full
# Everything in this "who may do what" group — create policy, anonymous sites, default visibility, expiry, quotas — can
# also be changed from the administration console (/admin/settings) without a rebuild; a console value overrides the variable.
# Anonymous sites without an account owner expire this many days after their last change. Signing in from the
# creating browser adopts its sites and stops their expiry clock; an administrator can also assign an unowned site.
# Expired sites follow the normal delete + retention path and can be restored by an administrator. 0 or unset = never.
# ARTIFACT_ANON_SITE_TTL_DAYS=30

# Upload limits (plain byte counts). Defaults: 300MB per version / 2000 files / 250MB per file. Lower them on public-facing machines.
# ARTIFACT_MAX_BYTES=314572800
# ARTIFACT_MAX_FILES=2000
# ARTIFACT_MAX_FILE_BYTES=262144000

# Rate limiting on write routes (in-process token bucket; clients identified by the X-Real-IP / X-Forwarded-For the reverse proxy injects).
# Only the literal off disables it.
# ARTIFACT_RATE_LIMIT=on
# ARTIFACT_RATE_LIMIT_BURST=20
# ARTIFACT_RATE_LIMIT_PER_MIN=30

# Address of an external editing assistant to embed on the site page (a floating window that receives the site's
# slug, kind and current version). Leave empty to disable; there is no default.
# ARTIFACT_ASSISTANT_URL=

# ════════════════════════════════════════════════════════════════════════
# 6. The deployment kit itself (used by `make`; platform deployments do not read these)
# ════════════════════════════════════════════════════════════════════════

# Host directory where uploaded files land (default ./data under the repository). Put it on the data disk and include it in backups.
ARTIFACT_DATA_PATH=./data
# The app port binds to loopback only: rate limiting trusts the headers injected by the reverse proxy, so 4300 must not be reachable directly. Change BIND only when the proxy runs on another machine.
ARTIFACT_BIND=127.0.0.1
ARTIFACT_PORT=4300
# Which image to run. A local make build produces artifact-site:local; when pulling from a registry use the full name.
ARTIFACT_IMAGE=artifact-site:local
# Build arguments for when the server cannot reach Docker Hub / the official npm registry (used by make build / make image; platform builds use the defaults).
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
