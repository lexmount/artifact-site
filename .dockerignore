# Build context hygiene — keep the image lean and the build deterministic.
node_modules
.next
.data
.git
.gitignore
.DS_Store
*.log

# Local env / secrets never enter an image layer.
.env
.env.local
.env.*.local

# Dev-only material the runtime never needs.
test
test-results
playwright-report
coverage
docs
*.md
!README.md

# The CLI is its own package; never part of the server image.
cli

# Docker meta itself.
Dockerfile
.dockerignore
docker-compose.yml

# Volatile generated files (regenerated by next build).
next-env.d.ts
tsconfig.tsbuildinfo

# Single-host deployment kit and its state — the image never needs any of it.
Makefile
compose
deploy
scripts/deploy
data
pgdata
caddy
backups
dist
